{
  "name": "rust-toolchain-matrix",
  "module": "src/index.ts",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "description": "Parse Cargo.toml and rust-toolchain.toml into GitHub Actions matrix strategies",
  "version": "0.0.1",
  "author": "Elio Severo Junior <elioseverojunior@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elioseverojunior/rust-toolchain-matrix.git"
  },
  "homepage": "https://github.com/elioseverojunior/rust-toolchain-matrix#readme",
  "bugs": {
    "url": "https://github.com/elioseverojunior/rust-toolchain-matrix/issues"
  },
  "keywords": [
    "github-actions",
    "rust",
    "cargo",
    "matrix",
    "ci",
    "msrv",
    "rust-toolchain",
    "cargo-toml"
  ],
  "engines": {
    "node": ">=24.0.0,<25.0.0",
    "bun": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "@stryker-mutator/core": "^10.1.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "action-docs": "^2.5.1",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "bun run build:action",
    "build:action": "bun build src/index.ts --outdir dist --target node --external none",
    "lint": "bun run eslint:lint && bun run prettier:format",
    "deps": "bunx --bun npm-check-updates -u --target minor && bun install",
    "deps:check": "bunx --bun npm-check-updates --target minor",
    "deps:latest": "bunx --bun npm-check-updates -u --target latest && bun install",
    "prettier:format": "prettier --check .",
    "prettier:format:fix": "prettier --write .",
    "eslint:lint": "eslint --max-warnings 0 .",
    "eslint:lint:fix": "eslint --fix --max-warnings 0 .",
    "fix:all": "bun run eslint:lint:fix && bun run prettier:format:fix",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "smol-toml": "^1.8.0"
  }
}
