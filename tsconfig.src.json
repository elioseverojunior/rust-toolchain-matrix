{
  "extends": ["./tsconfig.base.json"],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@rust-project-parser": ["./src/lib.ts"],
      "@rust-project-parser/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "docs", "dist"]
}
